APP_NAME="Battleships SIOS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# URL con la que se abre el juego en el navegador (sin diagonal final)
APP_URL=http://localhost/battle_ships

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX
APP_TIMEZONE=America/Mexico_City

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ------------------------------------------------------------------
# Base de datos PROPIA del juego (partidas, chat, presencia)
# ------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=battle_ships
DB_USERNAME=root
DB_PASSWORD=

# ------------------------------------------------------------------
# Base de datos de SIOS (solo lectura: de aquí salen los usuarios)
# Si está en el mismo servidor MySQL basta con SIOS_DB_DATABASE;
# host, puerto, usuario y contraseña se heredan de DB_* si se dejan vacíos.
# ------------------------------------------------------------------
SIOS_DB_DATABASE=sios_app_web
#SIOS_DB_HOST=127.0.0.1
#SIOS_DB_PORT=3306
#SIOS_DB_USERNAME=root
#SIOS_DB_PASSWORD=

# URL de SIOS para mostrar los avatares de los usuarios (opcional)
SIOS_URL=http://localhost/sios_app_web/public

# Roles de SIOS que pueden jugar, separados por comas. Vacío = todos.
BATTLESHIPS_ALLOWED_ROLES=

SESSION_DRIVER=file
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/battle_ships
SESSION_DOMAIN=null
SESSION_COOKIE=battleships_session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
